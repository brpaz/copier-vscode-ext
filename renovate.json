{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "npm": {
        "managerFilePatterns": [
            "/(^|/)package\\.json$/",
            "/(^|/)package\\.json\\.jinja$/"
        ]
    },
    "github-actions": {
        "managerFilePatterns": [
            "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
        ]
    },
    "packageRules": [
        {
            "description": "Group and automerge non-major updates",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "non-major updates",
            "automerge": true,
            "platformAutomerge": true
        }
    ],
    "prHourlyLimit": 5,
    "prConcurrentLimit": 20,
    "labels": [
        "dependencies"
    ],
    "reviewers": [
        "brpaz"
    ]
}